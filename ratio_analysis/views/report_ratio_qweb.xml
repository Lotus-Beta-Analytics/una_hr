<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_ratio_analysis">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <h2>Ratio Analysis Report</h2>
                    <p><strong>Date Range:</strong> <t t-esc="doc['date_from']"/> - <t t-esc="doc['date_to']"/></p>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Ratio</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc['lines']" t-as="line">
                                <tr>
                                    <td><t t-esc="line['name']"/></td>
                                    <td><t t-esc="line['columns'][0]['name']"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <report
        id="action_ratio_analysis_pdf"
        model="ratio.analysis.report.handler"
        string="Ratio Analysis Report"
        report_type="qweb-pdf"
        name="ratio_analysis.report_ratio_analysis"
        file="ratio_analysis.report_ratio_analysis"
        print_report_name="'Ratio Analysis - %s' % (object._get_report_name())"
    />
</odoo>