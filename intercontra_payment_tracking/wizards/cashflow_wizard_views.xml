
<odoo>
    <record id="view_intercontra_cashflow_wizard_form" model="ir.ui.view">
        <field name="name">intercontra.cashflow.wizard.form</field>
        <field name="model">intercontra.cashflow.wizard</field>
        <field name="arch" type="xml">
            <form string="Cashflow Projection">
                <group>
                    <field name="client"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_compute" string="Open Milestones" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_intercontra_cashflow_wizard" model="ir.actions.act_window">
        <field name="name">Cashflow Projection</field>
        <field name="res_model">intercontra.cashflow.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
