<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_ticket_groups" model="ir.ui.view">
        <field name="name">res.users.form.ticket.groups</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook/page[@name='access_rights']" position="inside">

                <field name="ticket_category_id" invisible="1"/>

                <group string="Ticket Request Access">
                    <field name="ticket_groups_ids"
                           widget="many2many_checkboxes"
                           domain="[('category_id', '=', ticket_category_id)]"
                           options="{'no_create': True}"
                           groups="base.group_system,base.group_erp_manager"/>
                </group>

            </xpath>

        </field>
    </record>
</odoo>
