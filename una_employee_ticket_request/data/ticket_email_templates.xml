<odoo>
  <data noupdate="1">

    <record id="mail_template_ticket_request_approved" model="mail.template">
      <field name="name">Notify Employee: Ticket Request Approved</field>
      <field name="model_id" ref="model_employee_ticket_request"/>
      <field name="subject">Your Ticket Request ({{ object.name }}) Has Been Approved</field>
      <field name="email_from">{{ user.email or 'hr@notify.flyunitednigeria.com' }}</field>
      <field name="email_to">{{ object.employee_id.work_email }}</field>
      <field name="body_html"><![CDATA[
        <html>
        <body>
          <p>Dear <t t-esc="object.employee_id.name or 'Employee'" />,</p>

          <p>Your travel ticket request <strong><t t-esc="object.name" /></strong> has been approved.</p>
           <p><strong>Ticket Request Details:</strong></p>
                <ul>
                  <li><strong>Request ID:</strong> <t t-esc="object.name"/></li>
                  <li><strong>Employee Name:</strong> <t t-esc="object.employee_id.name or 'N/A'"/></li>
                  <li><strong>Email:</strong> <t t-esc="object.employee_id.work_email or 'N/A'"/></li>
                  <li><strong>Department:</strong> <t t-esc="object.department_id.name or 'N/A'"/></li>
                  <li><strong>Duration:</strong> <t t-esc="object.duration or 0"/> days</li>
                  <li><strong>Outbound:</strong> <pre><t t-esc="object.outbound_trip or ''"/></pre></li>
                  <li><strong>Inbound:</strong> <pre><t t-esc="object.inbound_trip or ''"/></pre></li>
                  <li><strong>PNR:</strong> <t t-esc="object.pnr or 'N/A'"/></li>
                  <li><strong>Purpose:</strong> <pre><t t-esc="object.purpose or ''"/></pre></li>
                  <li><strong>Status:</strong> <t t-esc="object.state_summary or 'N/A'"/></li>
                </ul>

                <p><strong>Traveler Summary:</strong></p>
                  <ul>
                    <t t-if="object.employee_self_travel">
                      <li><strong><t t-esc="object.employee_id.name"/> (Employee)</strong> – 🎫 
                          <t t-esc="'2' if (object.outbound_trip and object.inbound_trip) else '1'"/> ticket(s)
                      </li>
                      <li><strong>Travel Date:</strong> <t t-esc="object.travel_date or 'N/A'"/></li>
                      <li><strong>Return Date:</strong> <t t-esc="object.return_date or 'N/A'"/></li>
                    </t>
                    <t t-if="object.pax_name">
                      <li><strong><t t-esc="object.pax_name"/></strong> (PAX 1 - <t t-esc="object.call_relationship or 'N/A'"/>) – 🎫 
                          <t t-esc="'2' if (object.outbound_trip and object.inbound_trip) else '1'"/> ticket(s)
                      </li>
                      <li><strong>Pax 1 Travel Date:</strong> <t t-esc="object.travel_date_pax1 or 'NONE'"/></li>
                      <li><strong>Pax 1 Return Date:</strong> <t t-esc="object.return_date_pax1 or 'NONE'"/></li>
                    </t>
                    <t t-if="object.pax2_name">
                      <li><strong><t t-esc="object.pax2_name"/></strong> (PAX 2 - <t t-esc="object.call_relationship2 or 'N/A'"/>) – 🎫 
                          <t t-esc="'2' if (object.outbound_trip and object.inbound_trip) else '1'"/> ticket(s)
                      </li>
                      <li><strong>Pax 2 Travel Date:</strong> <t t-esc="object.travel_date_pax2 or 'NONE'"/></li>
                      <li><strong>Pax 2 Return Date:</strong> <t t-esc="object.return_date_pax2 or 'NONE'"/></li>
                    </t>
                    <t t-if="object.pax3_name">
                      <li><strong><t t-esc="object.pax3_name"/></strong> (PAX 3 - <t t-esc="object.call_relationship3 or 'N/A'"/>) – 🎫 
                          <t t-esc="'2' if (object.outbound_trip and object.inbound_trip) else '1'"/> ticket(s)
                      </li>
                      <li><strong>Pax 3 Travel Date:</strong> <t t-esc="object.travel_date_pax3 or 'NONE'"/></li>
                      <li><strong>Pax 3 Return Date:</strong> <t t-esc="object.return_date_pax3 or 'NONE'"/></li>
                    </t>
                  </ul>
                <p><strong>Total No of Tickets that was Approved are:</strong> <t t-esc="object.ticket_count"/> 🎫 Tickets</p>
               <p>You can view this ticket request here:</p>
              <p>

                <p>You can view this ticket request here:</p>
                <p>
                  <a t-att-href="object.get_request_form_url()" target="_blank">Open Ticket Request</a>
                </p>

          <p>Your ticket has been marked as issued in the system.</p>

          <p>Regards,<br/>HR & Travel Admin</p>
        </body>
        </html>
      ]]></field>
    </record>


