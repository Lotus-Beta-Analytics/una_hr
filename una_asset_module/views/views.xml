<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- Form view -->
  <record id="view_account_asset_form_inherit_custom" model="ir.ui.view">
    <field name="name">account.asset.form.inherit.custom</field>
    <field name="model">account.asset</field>
    <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
    <field name="arch" type="xml">
        <xpath expr="//group[@name='asset_values']" position="inside">
            <field name="asset_location_id" options="{'no_create_edit': False}" context="{'default_name': 'New Location'}"/>
            <field name="sub_category_id"/>
            <field name="asset_serial"/>
            <field name="non_depreciable_percentage"/>
            <!-- <field name="asset_invoice"/> -->
            <field name="asset_supplier"/>
            <!-- <field name="invoice_name"/> -->
            <field name="quantity"/>
            <field name="unit_price"/>
            <!-- <field name="parent_id"/> -->
            <!-- <field name="main_category_asset_count"/> -->
            <field name="sub_asset_count"/>
        </xpath>
    </field>
  </record>


  <!-- Tree view -->
  <record id="view_account_asset_tree_inherit_custom" model="ir.ui.view">
    <field name="name">account.asset.tree.inherit.custom</field>
    <field name="model">account.asset</field>
    <field name="inherit_id" ref="account_asset.view_account_asset_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="after">
        <field name="sub_category_id"/>
        <field name="asset_location_id"/>
        <field name="asset_serial"/>
        <field name="asset_supplier"/>
        <!-- <field name="invoice_name"/> -->
        <field name="quantity"/>
        <field name="unit_price"/>
        <field name="bill_id"/>
        <!-- <field name="main_category_asset_count"/> -->
        <!-- <field name="sub_asset_count"/> -->
      </xpath>
    </field>
  </record>


  <!-- Search view -->
  <record id="view_account_asset_search_inherit_custom" model="ir.ui.view">
    <field name="name">account.asset.search.inherit.custom</field>
    <field name="model">account.asset</field>
    <field name="inherit_id" ref="account_asset.view_account_asset_search"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <field name="sub_category_id"/>
        <field name="parent_id"/>
        <filter name="has_parent" string="Has Parent" domain="[('parent_id', '!=', False)]"/>
        <filter name="no_parent" string="Top-Level" domain="[('parent_id', '=', False)]"/>
        <group expand="0" string="Group By">
          <filter name="group_by_parent" string="Parent" context="{'group_by': 'parent_id'}"/>
          <filter name="group_by_sub_category" string="Sub-Category" context="{'group_by': 'sub_category_id'}"/>
        </group>
      </xpath>
    </field>
  </record>

  

  <!-- Sub-category tree view -->
  <record id="view_asset_sub_category_tree" model="ir.ui.view">
    <field name="name">asset.sub.category.tree</field>
    <field name="model">asset.sub.category</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="category_id"/>
        <field name="asset_count"/>
      </tree>
    </field>
  </record>

  <!-- Sub-category form view -->
  <record id="view_asset_sub_category_form" model="ir.ui.view">
    <field name="name">asset.sub.category.form</field>
    <field name="model">asset.sub.category</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="category_id"/>
            <field name="asset_count" readonly="1"/>
            <field name="asset_ids" readonly="1" widget="many2many_tags"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Sub-category action and menu -->
  <record id="action_asset_sub_category" model="ir.actions.act_window">
    <field name="name">Asset Sub-Categories</field>
    <field name="res_model">asset.sub.category</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_asset_sub_category_root"
            name="Asset Sub-Categories"
            parent="account.menu_finance_configuration"
            action="action_asset_sub_category"
            sequence="105"/>



  <menuitem id="menu_asset_location_root"
          name="Asset Locations"
          parent="account.menu_finance_configuration"
          sequence="100"/>

  <record id="action_asset_location" model="ir.actions.act_window">
      <field name="name">Asset Locations</field>
      <field name="res_model">asset.location</field>
      <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_asset_location_sub"
            name="Manage Locations"
            parent="menu_asset_location_root"
            action="action_asset_location"
            sequence="10"/>

</odoo>
