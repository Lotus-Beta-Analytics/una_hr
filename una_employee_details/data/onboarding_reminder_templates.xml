<odoo>
    <record id="onboarding_reminder_email_template" model="mail.template">
        <field name="name">Onboarding Document Reminder</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="email_from">{{ object.company_id.email or object.department_id.manager_id.work_email or 'hr@yourcompany.com' }}</field>
        <field name="email_to">{{ object.work_email }}</field>
        <field name="subject">Reminder: Pending Onboarding Documents for {{ object.name }}</field>
        <field name="body_html"><![CDATA[
            <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
                <p>Dear <t t-esc="object.name"/>,</p>

                <p>We kindly remind you that you have <t t-esc="ctx.get('pending_count', 0)"/> pending onboarding document(s) to submit:</p>

                <t t-if="ctx.get('pending_documents', [])">
                    <ul>
                        <t t-foreach="ctx.get('pending_documents', [])" t-as="doc">
                            <li><t t-esc="doc"/></li>
                        </t>
                    </ul>
                </t>
                <t t-else="">
                    <p>No specific documents identified. Please check the HR portal for details.</p>
                </t>

                <p>Please log in to the HR portal and upload the required documents at your earliest convenience.</p>

                <p>You can access the onboarding section here:<br/>
                    <a t-att-href="object.get_base_url() + '/'">Click here to access the HR portal</a>
                </p>
                <p>Best regards,<br/>
                HR Department<br/>
                <t t-esc="object.company_id.name"/></p>
            </div>
        ]]></field>
    </record>

</odoo>