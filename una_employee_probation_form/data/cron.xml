<odoo>
  <data>

    <record id="ir_cron_notify_probation_review" model="ir.cron">
      <field name="name">Notify Employees for Probation Review</field>
      <field name="model_id" ref="model_hr_probation_review"/>
      <field name="state">code</field>
      <field name="code">model._send_probation_review_reminders()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
      <field name="doall" eval="False"/>
      <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).replace(hour=0, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')" />
      <field name="active">True</field>
    </record>

    <record id="ir_cron_notify_restarted_probation_review" model="ir.cron">
      <field name="name">Notify Employees for Restarted Probation Review</field>
      <field name="model_id" ref="una_employee_probation_form.model_hr_probation_review"/>
      <field name="state">code</field>
      <field name="code">model._send_restarted_probation_review_reminders()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
      <field name="doall" eval="False"/>
      <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).replace(hour=0, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')" />
      <field name="active">True</field>
    </record>


  </data>
</odoo>
