<odoo>
  <template id="onboarding_upload_styles" inherit_id="web.layout">
    <xpath expr="//head" position="inside">
      <style type="text/css">
        .custom-upload .o_form_binary_file {
          background-color: #6f42c1 !important;
          color: white !important;
          padding: 6px 10px;
          border-radius: 4px;
          border: 1px solid #6f42c1 !important;
          font-weight: bold;
        }
        .custom-upload .o_form_binary_file:hover {
          background-color: #59359c !important;
        }
      </style>
    </xpath>
  </template>
</odoo>
