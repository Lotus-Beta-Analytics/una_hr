<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_onboarding_upload_wizard_form" model="ir.ui.view">
      <field name="name">onboarding.upload.wizard.form</field>
      <field name="model">onboarding.upload.wizard</field>
      <field name="arch" type="xml">
        <form string="UNITED NIGERIA NEW STAFF ONBOARDING PROCESS">
          <sheet>
            <group>
              <field name="employee_id" readonly="1"/>
            </group>
            
            <group col="4">
              <field name="loe_ack_attachment" widget="many2many_binary" options="{'no_create': True}" string="ACKNOWLEDGED COPY OF LOE RECEIVED/EXECUTED" class="btn-primary"/>
              <field name="loe_ack_attachment_status_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
              <newline/>

              <field name="bond_ack_attachment" widget="many2many_binary" options="{'no_create': True}" string="THE BOND LETTER ACKNOWLEDGED RECEIVED/EXECUTED AND NOTARIZED" class="btn-primary"/>
              <field name="bond_ack_attachment_status_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
              <newline/>

              <field name="background_attachment" widget="many2many_binary" options="{'no_create': True}" string="BACKGROUND FORM COMPLETED/ RETURNED/ AND VERIFICATION CHECKED" class="btn-primary"/>
              <field name="background_attachment_status_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
              <newline/>

              <field name="police_report_attachment" widget="many2many_binary" options="{'no_create': True}" colspan="2" string="POLICE REPORT COMPLETED FROM SECURITY DEPT" class="btn-primary"/>
              <field name="police_report_attachment_status_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
              <newline/>

              <field name="medical_attachment" widget="many2many_binary" options="{'no_create': True}" colspan="2" string="MEDICAL REPORT COMPLETED" class="btn-primary"/>
              <field name="medical_attachment_status_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
              <newline/>

              <field name="employment_form_attachment" widget="many2many_binary" options="{'no_create': True}" string="ONBOARDING EMPLOYMENT FORM EXECUTED" class="btn-primary"/>
              <field name="employment_form_attachment_status_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
              <newline/>

              <field name="passport_photo_attachment" widget="many2many_binary" options="{'no_create': True}" string="PASSPORT PHOTOGRAPHS" class="btn-primary"/>
              <field name="passport_photo_attachment_status_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
              <newline/>

              <field name="credentials_attachment" widget="many2many_binary" options="{'no_create': True}" colspan="2" string="COPIES OF CREDENTIALS" class="btn-primary"/>
              <field name="credentials_attachment_status_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
              <newline/>

              <field name="wace_attachment" widget="many2many_binary" options="{'no_create': True}" string="WAEC / NECO RESULT" class="btn-primary"/>
              <field name="wace_attachment_status_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
              <newline/>

             <field name="bsc_attachment" widget="many2many_binary" options="{'no_create': True}" string="B.Sc." class="btn-primary"/>
             <field name="bsc_attachment_status_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
              <newline/>

              <field name="msc_attachment" widget="many2many_binary" options="{'no_create': True}" string="MASTER'S" class="btn-primary"/>
              <field name="msc_attachment_status_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
              <newline/>

              <field name="phd_attachment" widget="many2many_binary" options="{'no_create': True}" string="PHD RESULT" class="btn-primary"/>
              <field name="phd_attachment_status_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
              <newline/>

              <field name="onboarding_id_card" widget="radio"/>
              <newline/>

              <field name="onboarding_uniforms" widget="radio"/>
              <newline/>

              <field name="referees_attachment" widget="many2many_binary" options="{'no_create': True}" string="REFEREES /GUARANTOR FORM FILLED/ COLLECTED" class="btn-primary"/>
              <field name="referees_attachment_status_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
              <newline/>

              <field name="licenses_attachment" widget="many2many_binary" options="{'no_create': True}" string="LICENSES COLLECTED AND DOCUMENT APPLICABLE FOR PILOTS/ CABIN CREW, FLIGHT DISPATCHERS, ENGINEERS / PLANNING" class="btn-primary"/>
              <field name="licenses_attachment_status_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
              <newline/>

              <field name="cv_attachment" widget="many2many_binary" options="{'no_create': True}" colspan="2" string ="CV" class="btn-primary"/>
              <field name="cv_attachment_status_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
              <newline/>

              <field name="documented_attachment" widget="many2many_binary" options="{'no_create': True}" string="ACKNOWLEDGED CYBERSECURITY POLICY" class="btn-primary"/>
              <field name="documented_attachment_status_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
              <newline/>
  

             
              <field name="onboarding_account" widget="radio"/>
              <newline/>

              <field name="onboarding_tools" widget="radio"/>
              <newline/>
              
              <field name="onboarding_handbook" widget="radio"/>
              <newline/>
              
              <field name="onboarding_email" widget="radio"/>
              <newline/>
              
            </group>

            <footer>
              <button string="Submit" type="object" name="action_upload" class="btn-primary"/>
              <button string="Cancel" special="cancel"/>
            </footer>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_onboarding_upload_wizard" model="ir.actions.act_window">
      <field name="name">UNITED NIGERIA NEW STAFF ONBOARDING PROCESS</field>
      <field name="res_model">onboarding.upload.wizard</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
    </record>

 
    <menuitem id="menu_onboarding_upload_root"
              name="Onboarding Upload"
              parent="hr.menu_hr_root"
              sequence="100"
              groups="una_employee_details.group_new_employee"/>

    <menuitem id="menu_onboarding_upload"
              name="Upload File"
              parent="menu_onboarding_upload_root"
              action="action_onboarding_upload_wizard"
              groups="una_employee_details.group_new_employee"/>

  </data>
</odoo>
