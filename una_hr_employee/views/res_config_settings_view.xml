<odoo>
  <record id="action_hr_department_station" model="ir.actions.act_window">
    <field name="name">Department/Stations</field>
    <field name="res_model">hr.department.station</field>
    <field name="view_mode">tree,form</field>
  </record>


  <record id="view_res_config_settings_inherit_employee" model="ir.ui.view">
    <field name="name">res.config.settings.employee.inherit</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">

    <xpath expr="//form//group[last()]" position="after">
      <group string="Employee Settings" class="app_settings_block">
        <field name="department_station_id" options="{'no_create': True}"/>
      </group>
    </xpath>

    </field>
  </record>


  <menuitem id="menu_hr_employee_config_root" name="Employee Setup" parent="hr.menu_hr_root" sequence="30"/>
  <menuitem id="menu_hr_department_station" name="Department/Stations" parent="menu_hr_employee_config_root" action="action_hr_department_station" sequence="10"/>
</odoo>
