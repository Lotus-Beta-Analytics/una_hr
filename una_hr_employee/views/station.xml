<odoo>
    <!-- Action to open the model -->
    <record id="action_hr_employee_station_ids" model="ir.actions.act_window">
        <field name="name">Department/Station</field>
        <field name="res_model">hr.employee.station</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define the departments/stations employees may be assigned to.
            </p>
        </field>
    </record>

    <!-- Tree view -->
    <record id="view_hr_employee_station_tree" model="ir.ui.view">
        <field name="name">hr.employee.station.tree</field>
        <field name="model">hr.employee.station</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_hr_employee_station_form" model="ir.ui.view">
        <field name="name">hr.employee.station.form</field>
        <field name="model">hr.employee.station</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_employee_form_station_extend" model="ir.ui.view">
        <field name="name">hr.employee.form.station</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Insert after department_id field -->
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="station_id"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_hr_employee_station_ids"
              name="Department/Station"
              parent="hr.menu_config_employee"
              action="action_hr_employee_station_ids"
              sequence="10"/>
</odoo>
